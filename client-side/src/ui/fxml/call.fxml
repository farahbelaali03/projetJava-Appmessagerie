<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.shape.Circle?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="ui.CallController"
        prefWidth="800"
        prefHeight="600"
        style="-fx-background-color: #1a1a2e;">

    <!-- ════════════════════════════════ -->
    <!-- ZONE VIDEO PRINCIPALE           -->
    <!-- ════════════════════════════════ -->
    <center>
        <StackPane>

            <!-- Video distante (plein écran) -->
            <StackPane fx:id="paneVideoDistante"
                       style="-fx-background-color: #16213e;">
                <MediaView fx:id="viewVideoDistant"
                           fitWidth="800"
                           fitHeight="500"
                           preserveRatio="true" />
                <!-- Placeholder quand pas de vidéo -->
                <VBox fx:id="placeholderDistant"
                      alignment="CENTER"
                      spacing="15">
                    <Circle fx:id="avatarDistant"
                            radius="60"
                            style="-fx-fill: #0f3460;" />
                    <Label fx:id="labelNomDistant"
                           text="Correspondant"
                           style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
                    <Label fx:id="labelStatutAppel"
                           text="Appel en cours..."
                           style="-fx-text-fill: #a0a0b0; -fx-font-size: 14px;" />
                </VBox>
            </StackPane>

            <!-- Video locale (miniature coin bas-droite) -->
            <StackPane fx:id="paneVideoLocale"
                       maxWidth="200"
                       maxHeight="150"
                       style="-fx-background-color: #0f3460; -fx-border-color: #e94560; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8;"
                       StackPane.alignment="BOTTOM_RIGHT">
                <StackPane.margin>
                    <Insets bottom="20" right="20" />
                </StackPane.margin>
                <MediaView fx:id="viewVideoLocal"
                           fitWidth="200"
                           fitHeight="150"
                           preserveRatio="true" />
                <Label fx:id="labelVideoLocalOff"
                       text="Caméra désactivée"
                       style="-fx-text-fill: #a0a0b0; -fx-font-size="11px";"
                visible="false" />
            </StackPane>

            <!-- Durée de l'appel -->
            <Label fx:id="labelDuree"
                   text="00:00"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-background-color: rgba(0,0,0,0.5); -fx-padding: 5 12 5 12; -fx-background-radius: 20;"
                   StackPane.alignment="TOP_LEFT">
                <StackPane.margin>
                    <Insets top="15" left="15" />
                </StackPane.margin>
            </Label>

            <!-- Nom du correspondant (rappel en haut) -->
            <Label fx:id="labelNomHaut"
                   text=""
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-background-color: rgba(0,0,0,0.5); -fx-padding: 5 12 5 12; -fx-background-radius: 20;"
                   StackPane.alignment="TOP_RIGHT">
                <StackPane.margin>
                    <Insets top="15" right="15" />
                </StackPane.margin>
            </Label>

        </StackPane>
    </center>

    <!-- ════════════════════════════════ -->
    <!-- PANNEAU D'ENTRÉE (APPEL ENTRANT) -->
    <!-- ════════════════════════════════ -->
    <top>
        <VBox fx:id="panneauAppelEntrant"
              alignment="CENTER"
              spacing="12"
              visible="false"
              managed="false"
              style="-fx-background-color: rgba(15,52,96,0.95); -fx-padding: 20;">
            <Label fx:id="labelAppelEntrant"
                   text="Appel entrant de : ..."
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
            <HBox alignment="CENTER" spacing="30">
                <!-- Accepter -->
                <Button fx:id="btnAccepterAppel"
                        text="✔  Accepter"
                        onAction="#accepterAppel"
                        style="-fx-background-color: #25d366; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25 10 25; -fx-background-radius: 25; -fx-cursor: hand;" />
                <!-- Refuser -->
                <Button fx:id="btnRefuserAppel"
                        text="✘  Refuser"
                        onAction="#refuserAppel"
                        style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 25 10 25; -fx-background-radius: 25; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </top>

    <!-- ════════════════════════════════ -->
    <!-- BARRE DE CONTRÔLE (BAS)          -->
    <!-- ════════════════════════════════ -->
    <bottom>
        <HBox alignment="CENTER"
              spacing="25"
              style="-fx-background-color: rgba(15,52,96,0.9); -fx-padding: 18;">

            <!-- Micro ON/OFF -->
            <Button fx:id="btnMicro"
                    text="🎤"
                    onAction="#toggleMicro"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-size: 20px; -fx-min-width: 55; -fx-min-height: 55; -fx-background-radius: 50; -fx-cursor: hand; -fx-border-color: #4a90d9; -fx-border-radius: 50; -fx-border-width: 2;" />

            <!-- Caméra ON/OFF -->
            <Button fx:id="btnCamera"
                    text="📷"
                    onAction="#toggleCamera"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-size: 20px; -fx-min-width: 55; -fx-min-height: 55; -fx-background-radius: 50; -fx-cursor: hand; -fx-border-color: #4a90d9; -fx-border-radius: 50; -fx-border-width: 2;" />

            <!-- RACCROCHER (bouton central rouge) -->
            <Button fx:id="btnRaccrocher"
                    text="📵"
                    onAction="#raccrocher"
                    style="-fx-background-color: #e94560; -fx-text-fill: white; -fx-font-size: 24px; -fx-min-width: 70; -fx-min-height: 70; -fx-background-radius: 50; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(233,69,96,0.6), 15, 0, 0, 0);" />

            <!-- Haut-parleur ON/OFF -->
            <Button fx:id="btnHautParleur"
                    text="🔊"
                    onAction="#toggleHautParleur"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-size: 20px; -fx-min-width: 55; -fx-min-height: 55; -fx-background-radius: 50; -fx-cursor: hand; -fx-border-color: #4a90d9; -fx-border-radius: 50; -fx-border-width: 2;" />

            <!-- Basculer audio seul / vidéo -->
            <Button fx:id="btnModeAppel"
                    text="🎥 Vidéo"
                    onAction="#toggleModeAppel"
                    style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-font-size: 13px; -fx-min-width: 90; -fx-min-height: 55; -fx-background-radius: 25; -fx-cursor: hand; -fx-border-color: #4a90d9; -fx-border-radius: 25; -fx-border-width: 2;" />

        </HBox>
    </bottom>

</BorderPane>
